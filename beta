		T.Text = Config.Title or "Notifikasi"
		T.TextColor3 = RayfieldLibrary.Theme.Default.TabTextColor
		T.Font = Enum.Font.SourceSansBold
		T.TextSize = 14
		T.TextXAlignment = Enum.TextXAlignment.Left
		T.BackgroundTransparency = 1
		
		local C = Instance.new("TextLabel", N)
		C.Size = UDim2.new(1, -20, 0, 30)
		C.Position = UDim2.new(0, 10, 0, 24)
		C.Text = Config.Content or ""
