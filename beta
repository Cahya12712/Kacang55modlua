	function WindowHandler:CreateTab(Name)
		local TabBtn = Instance.new("TextButton", TabScroller)
		TabBtn.Size = UDim2.new(1, 0, 0, 35)
		TabBtn.BackgroundColor3 = firstPage and RayfieldLibrary.Theme.Default.TabBackgroundSelected or RayfieldLibrary.Theme.Default.TabBackground
		TabBtn.Text = Name
		TabBtn.TextColor3 = firstPage and RayfieldLibrary.Theme.Default.SelectedTabTextColor or RayfieldLibrary.Theme.Default.TabTextColor
		TabBtn.Font = Enum.Font.SourceSansBold
		TabBtn.TextSize = 14
		Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
		
		local Page = Instance.new("ScrollingFrame", ContentHolder)
		Page.Size = UDim2.new(1, 0, 1, 0)
		Page.BackgroundTransparency = 1
		Page.CanvasSize = UDim2.new(0, 0, 0, 0)
		Page.ScrollBarThickness = 3
		Page.ScrollBarImageColor3 = RayfieldLibrary.Theme.Default.TabBackgroundSelected
		local PageLayoutList = Instance.new("UIListLayout", Page)
		PageLayoutList.Padding = UDim.new(0, 8)
		
		PageLayoutList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			Page.CanvasSize = UDim2.new(0, 0, 0, PageLayoutList.AbsoluteContentSize.Y + 15)
		end)
		
		TabBtn.MouseButton1Click:Connect(function()
			for _, btn in pairs(TabScroller:GetChildren()) do
				if btn:IsA("TextButton") then
					btn.BackgroundColor3 = RayfieldLibrary.Theme.Default.TabBackground
					btn.TextColor3 = RayfieldLibrary.Theme.Default.TabTextColor
				end
			end
			TabBtn.BackgroundColor3 = RayfieldLibrary.Theme.Default.TabBackgroundSelected
			TabBtn.TextColor3 = RayfieldLibrary.Theme.Default.SelectedTabTextColor
			PageLayout:JumpTo(Page)
		end)
		
		firstPage = false
		local TabHandler = {}
		
		function TabHandler:CreateSection(Text)
			local Sec = Instance.new("Frame", Page)
			Sec.Size = UDim2.new(1, -10, 0, 25)
			Sec.BackgroundTransparency = 1
			local Lbl = Instance.new("TextLabel", Sec)
			Lbl.Size = UDim2.new(1, 0, 1, 0)
			Lbl.Text = "— " .. Text .. " —"
			Lbl.TextColor3 = RayfieldLibrary.Theme.Default.TabBackgroundSelected
			Lbl.Font = Enum.Font.SourceSansBold
			Lbl.TextSize = 14
			Lbl.BackgroundTransparency = 1
		end
		
		function TabHandler:CreateToggle(Options)
			local Tgl = Instance.new("Frame", Page)
			Tgl.Size = UDim2.new(1, -10, 0, 40)
			Tgl.BackgroundColor3 = RayfieldLibrary.Theme.Default.ElementBackground
			Instance.new("UICorner", Tgl).CornerRadius = UDim.new(0, 6)
			Instance.new("UIStroke", Tgl).Color = RayfieldLibrary.Theme.Default.ElementStroke
			
			local Lbl = Instance.new("TextLabel", Tgl)
			Lbl.Size = UDim2.new(0.7, 0, 1, 0)
			Lbl.Position = UDim2.new(0, 10, 0, 0)
			Lbl.Text = Options.Name
			Lbl.TextColor3 = RayfieldLibrary.Theme.Default.TextColor
			Lbl.TextSize = 14
			Lbl.Font = Enum.Font.SourceSans
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.BackgroundTransparency = 1
			
			local Trigger = Instance.new("TextButton", Tgl)
			Trigger.Size = UDim2.new(0, 42, 0, 22)
			Trigger.Position = UDim2.new(1, -52, 0.5, -11)
			Trigger.BackgroundColor3 = Options.CurrentValue and RayfieldLibrary.Theme.Default.ToggleEnabled or RayfieldLibrary.Theme.Default.ToggleDisabled
			Trigger.Text = ""
			Instance.new("UICorner", Trigger).CornerRadius = UDim.new(1, 0)
			local S = Instance.new("UIStroke", Trigger)
			S.Color = Options.CurrentValue and RayfieldLibrary.Theme.Default.ToggleEnabledStroke or RayfieldLibrary.Theme.Default.ToggleDisabledStroke
			
			local Ball = Instance.new("Frame", Trigger)
			Ball.Size = UDim2.new(0, 14, 0, 14)
			Ball.Position = Options.CurrentValue and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 4, 0.5, -7)
			Ball.BackgroundColor3 = RayfieldLibrary.Theme.Default.SliderStroke
			Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)
			
			local active = Options.CurrentValue
			Trigger.MouseButton1Click:Connect(function()
				active = not active
				TweenService:Create(Trigger, TweenInfo.new(0.15), {BackgroundColor3 = active and RayfieldLibrary.Theme.Default.ToggleEnabled or RayfieldLibrary.Theme.Default.ToggleDisabled}):Play()
				TweenService:Create(S, TweenInfo.new(0.15), {Color = active and RayfieldLibrary.Theme.Default.ToggleEnabledStroke or RayfieldLibrary.Theme.Default.ToggleDisabledStroke}):Play()
				TweenService:Create(Ball, TweenInfo.new(0.15), {Position = active and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 4, 0.5, -7)}):Play()
				Options.Callback(active)
			end)
		end
		
		function TabHandler:CreateSlider(Options)
			local Sld = Instance.new("Frame", Page)
			Sld.Size = UDim2.new(1, -10, 0, 50)
			Sld.BackgroundColor3 = RayfieldLibrary.Theme.Default.ElementBackground
			Instance.new("UICorner", Sld).CornerRadius = UDim.new(0, 6)
			
			local Lbl = Instance.new("TextLabel", Sld)
			Lbl.Size = UDim2.new(0.6, 0, 0, 25)
			Lbl.Position = UDim2.new(0, 10, 0, 2)
			Lbl.Text = Options.Name
			Lbl.TextColor3 = RayfieldLibrary.Theme.Default.TextColor
			Lbl.TextSize = 14
			Lbl.Font = Enum.Font.SourceSans
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.BackgroundTransparency = 1
			
			local ValLbl = Instance.new("TextLabel", Sld)
			ValLbl.Size = UDim2.new(0.3, 0, 0, 25)
			ValLbl.Position = UDim2.new(1, -110, 0, 2)
			ValLbl.Text = tostring(Options.CurrentValue)
			ValLbl.TextColor3 = RayfieldLibrary.Theme.Default.SliderBackground
			ValLbl.TextSize = 14
			ValLbl.Font = Enum.Font.SourceSansBold
			ValLbl.TextXAlignment = Enum.TextXAlignment.Right
			ValLbl.BackgroundTransparency = 1
			
			local Track = Instance.new("TextButton", Sld)
			Track.Size = UDim2.new(1, -20, 0, 6)
			Track.Position = UDim2.new(0, 10, 0, 34)
			Track.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
			Track.Text = ""
			Instance.new("UICorner", Track)
			
			local Fill = Instance.new("Frame", Track)
			local startPercent = (Options.CurrentValue - Options.Range[1]) / (Options.Range[2] - Options.Range[1])
			Fill.Size = UDim2.new(math.clamp(startPercent, 0, 1), 0, 1, 0)
			Fill.BackgroundColor3 = RayfieldLibrary.Theme.Default.SliderBackground
			Instance.new("UICorner", Fill)
			
			local isDragging = false
			local function parseInput(input)
				local delta = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				local val = math.floor(Options.Range[1] + (delta * (Options.Range[2] - Options.Range[1])))
				ValLbl.Text = tostring(val)
				Fill.Size = UDim2.new(delta, 0, 1, 0)
				Options.Callback(val)
			end
			
			Track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDragging = true; parseInput(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					parseInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDragging = false
				end
			end)
		end
		
		function TabHandler:CreateButton(Options)
			local Btn = Instance.new("TextButton", Page)
			Btn.Size = UDim2.new(1, -10, 0, 36)
			Btn.BackgroundColor3 = Color3.fromRGB(42, 42, 42)
