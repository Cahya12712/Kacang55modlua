ExploitTab:CreateSection("Macro & Automation")
ExploitTab:CreateToggle({
    Name = "Spam Slide",
    CurrentValue = false,
    Callback = function(Value)
        States.SpamSlide = Value
        if Value then
            Window:Notify({Title = "Spam Slide", Content = "Spam Slide Diaktifkan! [ON]", Duration = 2})
            task.spawn(function()
                while States.SpamSlide do
                    if useKeybind then
                        pcall(function()
                            useKeybind:Fire({Key = "Crouch", Down = true})
                            task.wait(0.03)
                            useKeybind:Fire({Key = "Crouch", Down = false})
                        end)
                    else
                        Window:Notify({Title = "Error", Content = "Event UseKeybind tidak ditemukan di game ini!", Duration = 3})
                        States.SpamSlide = false
                        break
                    end
                    task.wait(0.05)
                end
            end)
        else
            Window:Notify({Title = "Spam Slide", Content = "Spam Slide Dimatikan! [OFF]", Duration = 2})
        end
    end,
})

ExploitTab:CreateSection("Lag Generation")
ExploitTab:CreateButton({
    Name = "Freeze Client (0.5 Detik)",
    Callback = function()
        if States.IsFreezing then return end
        States.IsFreezing = true
        Window:Notify({Title = "Freeze System", Content = "Sedang membekukan game (Freezing...)", Duration = 0.5})
        task.spawn(function()
            for i = 1, 10000 do
                print(string.rep("x", 500))
            end
        end)
        task.wait(0.5)
        States.IsFreezing = false
        Window:Notify({Title = "Freeze System", Content = "Freeze Selesai!", Duration = 2})
    end,
})

