-- Fungsi untuk membuat tombol dengan animasi hover standard
local function createButton(name, text, pos, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 125, 0, 45)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Parent = MainFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    -- Efek Sentuhan/Hover Ringan
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.15}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    end)
    
    return btn
end

-- Membuat Tombol Release & Beta
local ReleaseBtn = createButton("ReleaseBtn", "🚀 RELEASE", UDim2.new(0, 25, 0, 95), Color3.fromRGB(0, 150, 100))
local BetaBtn = createButton("BetaBtn", "🧪 BETA", UDim2.new(0, 170, 0, 95), Color3.fromRGB(200, 80, 80))

-- [ LOGIC BUTTON ACTIONS ]

local function launchScript(url)
    -- Hancurkan UI Pemilih dengan segera agar bersih
    LauncherGui:Destroy()
    
    -- Eksekusi skrip utama dari Github secara asinkronus
    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        
        if not success then
            warn("Gagal memuat skrip dari GitHub: " .. tostring(err))
        end
    end)
end

ReleaseBtn.MouseButton1Click:Connect(function()
    launchScript(releaseURL)
end)

BetaBtn.MouseButton1Click:Connect(function()
    launchScript(betaURL)
end)
