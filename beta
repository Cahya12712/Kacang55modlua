ExploitTab:CreateSection("Otomatisasi Game")
ExploitTab:CreateToggle({
    Name = "Spam Slide Otomatis",
    CurrentValue = false,
    Callback = function(Value)
        States.SpamSlide = Value
        if Value then
            if not useKeybind then setupKeybindEvent() end
            task.spawn(function()
                while States.SpamSlide do
                    if useKeybind then
                        pcall(function()
                            useKeybind:Fire({Key = "Crouch", Down = true})
                            task.wait(0.02)
                            useKeybind:Fire({Key = "Crouch", Down = false})
                        end)
                    else
                        Window:Notify({Title = "Sistem Error", Content = "Event Crouch game tidak ditemukan!", Duration = 2})
                        break
                    end
                    task.wait(0.04)
                end
            end)
        end
    end,
})

