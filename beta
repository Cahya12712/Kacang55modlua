        States.SpamSlide = Value
        if Value then
            if not useKeybind then setupKeybindEvent() end
            task.spawn(function()
                while States.SpamSlide do
                    if useKeybind then
                        pcall(function()
                            useKeybind:Fire({Key = "Crouch", Down = true})
                            task.wait(0.02)
                            useKeybind:Fire({Key = "Crouch", Down = false})
                        end)
                    else
                        break
                    end
                    task.wait(0.04)
                end
            end)
        end
    end,
})

player.CharacterAdded:Connect(function(char)
    if States.AutoApply then
        task.wait(0.8)
        applyBodyMod(char)
    end
end)

