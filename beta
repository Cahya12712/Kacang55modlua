local function startFly()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local att = hrp:FindFirstChild("kacang55_FlyAtt") or Instance.new("Attachment", hrp)
    att.Name = "kacang55_FlyAtt"
    
    local lv = hrp:FindFirstChild("kacang55_FlyLV") or Instance.new("LinearVelocity", hrp)
    lv.Name = "kacang55_FlyLV"
    lv.MaxForce = 999999
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.Attachment0 = att
    
    local bg = hrp:FindFirstChild("kacang55_FlyBG") or Instance.new("BodyGyro", hrp)
    bg.Name = "kacang55_FlyBG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 3000
    
    char.Humanoid.PlatformStand = true
    
    task.spawn(function()
        while States.Fly and char and char:FindFirstChild("HumanoidRootPart") do
            local cam = workspace.CurrentCamera
            lv.VectorVelocity = (char.Humanoid.MoveDirection * States.FlySpeed) + Vector3.new(0, upDownDir * States.FlySpeed, 0)
            bg.CFrame = cam.CFrame
            task.wait()
        end
        if lv then lv:Destroy() end
        if att then att:Destroy() end
        if bg then bg:Destroy() end
        if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
    end)
end

-- Touch TP Fixer
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not States.TouchTP then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local ray = workspace.CurrentCamera:ScreenPointToRay(input.Position.X, input.Position.Y)
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {char}
            params.FilterType = Enum.RaycastFilterType.Exclude
            
            local res = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
            if res then
                char.HumanoidRootPart.CFrame = CFrame.new(res.Position + Vector3.new(0, 3, 0))
                Window:Notify({Title = "Teleport", Content = "Berhasil pindah tempat!", Duration = 1.5})
            end
        end
    end
end)

-- Main RunService Loop (Anti Bug Rendering)
RunService.Stepped:Connect(function()
    local char = player.Character
    if char then
        if States.Noclip then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if char:FindFirstChild("Humanoid") then
            if char.Humanoid.WalkSpeed ~= States.WalkSpeed then char.Humanoid.WalkSpeed = States.WalkSpeed end
            if States.JumpPower > 50 then
                char.Humanoid.UseJumpPower = true
                if char.Humanoid.JumpPower ~= States.JumpPower then char.Humanoid.JumpPower = States.JumpPower end
            end
        end
    end
    if States.ESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hl = p.Character:FindFirstChild("kacang55_ESP")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "kacang55_ESP"
                    hl.FillColor = Color3.fromRGB(240, 161, 43)
                    hl.OutlineColor = Color3.fromRGB(250, 204, 206)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = p.Character
                end
            end
        end
    end
end)

